# Copy this file to .env. Never commit real keys or patient data.
# Each stage may use a hosted OpenAI-compatible API, a Modal endpoint, or a local server.
# The base URL is the API root ending in /v1; the model must match the served model ID.

# Stage 2: vision-language observation (must accept image_url data URLs).
OBSERVATION_PROVIDER=openai-compatible
OBSERVATION_MODEL=Qwen/Qwen3-VL-8B-Instruct
OBSERVATION_BASE_URL=http://127.0.0.1:8001/v1
OBSERVATION_API_KEY=local

# Stage 3: text-only, rubric-based assessment.
ASSESSMENT_PROVIDER=openai-compatible
ASSESSMENT_MODEL=gpt-oss-20b
ASSESSMENT_BASE_URL=http://127.0.0.1:8002/v1
ASSESSMENT_API_KEY=local
ASSESSMENT_IMAGES=never

# Optional speech-to-text. For a rubric with audio criteria, set a real
# transcription endpoint/key, or run with --audio never (reduced evidence).
AUDIO_PROVIDER=openai
AUDIO_MODEL=gpt-4o-mini-transcribe
AUDIO_LANGUAGE=zh
# AUDIO_API_KEY=replace-me
# AUDIO_BASE_URL=https://your-transcription-api.example/v1

# Only needed if OBSERVATION_PROVIDER, ASSESSMENT_PROVIDER, or AUDIO_PROVIDER
# is "openai" and that stage is actually called.
# OPENAI_API_KEY=replace-me

# Optional remote YOLO perception; unrelated to hosting the two LLM stages.
MODAL_YOLO_APP=skillens-yolo-perception
MODAL_YOLO_VOLUME=skillens-yolo-data
